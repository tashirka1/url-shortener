package view

import (
	"fmt"
	"url_shortener/internal/core/view"
	"url_shortener/internal/link/model"
)

templ QRCodeModal(code string, dataURI string) {
	<dialog open id="qr-modal" style="padding: 20px; max-width: 350px;" hx-on:click="if(event.target===this)this.removeAttribute('open')">
		<article style="margin: 0; text-align: center;">
			<header>
				<strong>QR-код</strong>
				<a href="#" style="float: right;" hx-on:click="document.getElementById('qr-modal').removeAttribute('open'); return false;">✕</a>
			</header>
			<img src={ templ.SafeURL(dataURI) } alt="QR code for { code }" style="display: block; margin: 0 auto;"/>
			<p><small>{ "/" + code }</small></p>
		</article>
	</dialog>
}

templ CreateLinkError(err string) {
	<div>{ err }</div>
}

templ CreateLinkSuccess(link model.Link) {
	@Link(link)
	<div id="create-link-errors" style="color:red;" hx-swap-oob="true"></div>
}

templ CreateLink(userId int, links []model.Link) {
	@view.Base("URL shortener", userId) {
		// <div hx-get="/link/create-link" hx-trigger="every 5s" hx-swap="none"></div>
		<div>
			<div class="grid">
				<div>
					<form hx-post="/link/create-link" hx-target="#list-links" hx-swap="afterbegin" hx-on:reset-create-form="this.reset()">
						<fieldset role="group">
							<input type="text" name="url" placeholder="Ссылка" aria-label="URL" required/>
							<button>Создать</button>
						</fieldset>
					</form>
					<div id="create-link-errors" style="color:red; margin-bottom: 10px;"></div>
				</div>
				<div style="margin-bottom: 10px;">
					<input
						type="search"
						name="q"
						placeholder="Поиск ссылок..."
						hx-get="/link/search-link"
						hx-trigger="keyup delay:300ms, search"
						hx-target="#list-links"
						aria-label="Поиск ссылок"
					/>
				</div>
			</div>
			<article style="overflow-y: auto;" id="links">
				<table>
					<thead>
						<tr>
							<th scope="col">Короткая ссылка</th>
							<th scope="col">Ссылка</th>
							<th scope="col">Переходы</th>
							<th scope="col">QR</th>
							<th scope="col">Удалить</th>
						</tr>
					</thead>
					<tbody id="list-links">
						@ListLink(links)
					</tbody>
				</table>
			</article>
			<div id="qr-modal-container"></div>
		</div>
	}
}

templ Link(link model.Link) {
	<tr>
		<td scope="row">
			<a href={ templ.URL(fmt.Sprintf("/%s", link.Code)) } class="shortLink" target="_blank">{ link.Code }</a>
		</td>
		<td>
			<a href={ templ.URL(link.Url) } target="_blank">{ link.Url }</a>
		</td>
		<td>{ fmt.Sprintf("%d", link.Clicks) }</td>
		<td>
			<button hx-get={ string(templ.URL(fmt.Sprintf("/link/%s/qr", link.Code))) } hx-target="#qr-modal-container" hx-swap="innerHTML">
				QR
			</button>
		</td>
		<td>
			<button hx-delete={ string(templ.URL(fmt.Sprintf("/link/remove-link/%s", link.Code))) } hx-target="closest tr" hx-swap="outerHTML">
				Удалить
			</button>
		</td>
	</tr>
}

templ LastLink(link model.Link) {
	<tr hx-get={ string(templ.URL(fmt.Sprintf("/link/list-link?cursor=%d", link.Id))) } hx-trigger="revealed" hx-swap="beforeend" hx-target="#list-links">
		<td scope="row">
			<a href={ templ.URL(fmt.Sprintf("/%s", link.Code)) } class="shortLink" target="_blank">{ link.Code }</a>
		</td>
		<td>
			<a href={ templ.URL(link.Url) } target="_blank">{ link.Url }</a>
		</td>
		<td>{ fmt.Sprintf("%d", link.Clicks) }</td>
		<td>
			<button hx-get={ string(templ.URL(fmt.Sprintf("/link/%s/qr", link.Code))) } hx-target="#qr-modal-container" hx-swap="innerHTML">
				QR
			</button>
		</td>
		<td>
			<button hx-delete={ string(templ.URL(fmt.Sprintf("/link/remove-link/%s", link.Code))) } hx-target="closest tr" hx-swap="outerHTML">
				Удалить
			</button>
		</td>
	</tr>
}

templ ListLink(links []model.Link) {
	for _, link:= range links {
		if link.Id == links[len(links)-1].Id {
			@LastLink(link)
		} else {
			@Link(link)
		}
	}
}

templ SearchResults(links []model.Link) {
	for _, link := range links {
		@Link(link)
	}
}
