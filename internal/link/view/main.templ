package view

import "url_shortener/internal/core/view"

templ Main(userId int) {
	@view.Base("URL Shortener", userId) {
		if userId == 0 {
			<article>
				<header><strong>Hello</strong></header>
				<p>You need to <a href="/auth/login">login</a> to access this page.</p>
				<p>Don't have an account? <a href="/auth/register">Register</a></p>
			</article>
		} else {
			<article>
				<header><strong>Links</strong></header>
				<p><a href="/link/create-link">Manage links</a></p>
			</article>
		}
	}
}
