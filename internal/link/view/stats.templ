package view

import (
	"fmt"
	"url_shortener/internal/core/view"
	"url_shortener/internal/link/model"
)

templ StatsPage(link model.Link, daily []model.DailyClick, referrers []model.ReferrerStat) {
	@view.Base("Статистика — URL shortener", 0) {
		<a href="/link/">← Назад к ссылкам</a>
		<article>
			<header>
				<strong>Статистика переходов</strong>
			</header>
			<p>
				<code>/{ link.Code }</code> → <a href={ templ.URL(link.Url) } target="_blank">{ link.Url }</a>
			</p>
			@ClickChart(buildChart(daily))
			@ReferrerTable(referrers)
		</article>
	}
}

templ ClickChart(cd ChartData) {
	if !cd.HasData {
		<p>Нет переходов за последние 30 дней</p>
	}
	if cd.HasData {
		<figure>
			<figcaption>Клики по дням</figcaption>
			<svg viewBox={ fmt.Sprintf("0 0 %d 230", cd.SvgWidth) } xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 230px;">
				for _, b := range cd.Bars {
					<rect x={ fmt.Sprintf("%d", b.X) } y={ fmt.Sprintf("%.0f", b.Y) } width="22" height={ fmt.Sprintf("%.0f", b.Height) } fill="#3b82f6" rx="2"/>
					<text x={ fmt.Sprintf("%d", b.X+11) } y={ fmt.Sprintf("%.0f", b.Y-4) } text-anchor="middle" font-size="9" fill="#555">{ fmt.Sprintf("%d", b.Clicks) }</text>
				}
				for _, b := range cd.Bars {
					<text x={ fmt.Sprintf("%d", b.X+11) } y="218" text-anchor="middle" font-size="9" fill="#888">{ b.Label }</text>
				}
			</svg>
		</figure>
	}
}

templ ReferrerTable(referrers []model.ReferrerStat) {
	<figure>
		<figcaption>Источники переходов</figcaption>
		<table>
			<thead>
				<tr>
					<th scope="col">Источник</th>
					<th scope="col">Переходы</th>
				</tr>
			</thead>
			<tbody>
				if len(referrers) == 0 {
					<tr>
						<td colspan="2">Нет данных</td>
					</tr>
				}
				if len(referrers) > 0 {
					for _, r := range referrers {
						<tr>
							<td>{ referrerName(r.Referrer) }</td>
							<td>{ fmt.Sprintf("%d", r.Clicks) }</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</figure>
}
